# FlyRank AI Internship Environment Variables Template
# Copy this file to .env and set your API keys. NEVER commit actual keys to Git.

# Gemini API Key (Optional: for live LLM execution tier)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Optional fallback)
OPENAI_API_KEY=your_openai_api_key_here

# LLM Client Execution Mode (Set to 1 to enable live API calls, 0 for offline semantic fallback engine)
USE_LIVE_LLM=0
